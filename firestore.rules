rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if current requester is admin or super_admin
    function isAdmin() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['super_admin', 'admin', 'moderator'];
    }

    function isSuperAdmin() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super_admin';
    }

    // ============================================
    // 1. ADMIN COLLECTIONS
    // ============================================
    match /admins/{adminId} {
      allow read: if request.auth != null && (adminId == request.auth.uid || isSuperAdmin());
      allow create: if request.auth != null && (
        request.resource.data.role == 'super_admin' ||
        (isSuperAdmin() && request.resource.data.role in ['admin', 'moderator'])
      );
      allow update, delete: if isSuperAdmin();
    }

    match /admin_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // ============================================
    // 2. USER PROFILES & ACCOUNTS
    // ============================================
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow delete: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
      
      // User notifications sub-collection
      match /notifications/{notificationId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null; // Other users / system can send notification
        allow update, delete: if request.auth != null && request.auth.uid == userId;
      }

      // User penalties sub-collection
      match /penalties/{penaltyId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow write: if isAdmin();
      }
    }

    match /buyer_profiles/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    match /driver_profiles/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    match /user_audit_logs/{logId} {
      allow create: if true;
      allow read, update: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin());
      allow delete: if isSuperAdmin();
    }

    // ============================================
    // 3. MONEY, WALLET & DIGITAL SOKOL CARD
    // ============================================
    match /cards/{userId} {
      allow read: if request.auth != null; // Needed for QR scan / P2P payment verification
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    match /wallets/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow delete: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
    }

    match /transactions/{transactionId} {
      allow get: if request.auth != null && (
        resource.data.userId == request.auth.uid || 
        resource.data.senderUid == request.auth.uid ||
        resource.data.receiverUid == request.auth.uid ||
        isAdmin()
      );
      allow list: if request.auth != null && (
        resource.data.userId == request.auth.uid || 
        resource.data.senderUid == request.auth.uid ||
        resource.data.receiverUid == request.auth.uid ||
        isAdmin()
      );
      allow create: if request.auth != null && (
        request.resource.data.userId == request.auth.uid || 
        request.resource.data.senderUid == request.auth.uid ||
        isAdmin()
      );
      allow update: if false; // Immutable ledger
      allow delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /payment_requests/{requestId} {
      allow read: if request.auth != null && (
        resource.data.senderId == request.auth.uid || 
        resource.data.receiverId == request.auth.uid ||
        isAdmin()
      );
      allow create: if request.auth != null && request.resource.data.senderId == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.receiverId == request.auth.uid || 
        resource.data.senderId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /transfer_requests/{requestId} {
      allow create: if request.auth != null && request.resource.data.senderId == request.auth.uid;
      allow read: if request.auth != null && (
        resource.data.senderId == request.auth.uid || 
        resource.data.receiverId == request.auth.uid ||
        isAdmin()
      );
      allow update: if request.auth != null && (
        resource.data.receiverId == request.auth.uid || 
        resource.data.senderId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /withdraw_requests/{requestId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /deposit_requests/{requestId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /microfinance_applications/{applicationId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /pin_reset_requests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null;
    }

    // ============================================
    // 4. FARM MANAGEMENT & FISHERIES SUITE
    // ============================================
    match /farms/{farmId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (
        resource.data.userId == request.auth.uid || 
        resource.data.ownerId == request.auth.uid || 
        isAdmin()
      );
    }

    match /fisheries_ponds/{pondId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (
        resource.data.userId == request.auth.uid || 
        isAdmin()
      );
    }

    match /crop_plantings/{plantingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    match /farm_activities/{activityId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    match /farm_expenses/{expenseId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    match /farm_revenues/{revenueId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    match /farm_inventory/{inventoryId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    match /harvest_logs/{logId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    match /water_quality_logs/{logId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // ============================================
    // 5. TRANSPORT & LOGISTICS
    // ============================================
    match /transport_bookings/{bookingId} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid || 
        resource.data.driverId == request.auth.uid || 
        isAdmin()
      );
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        resource.data.userId == request.auth.uid || 
        resource.data.driverId == request.auth.uid || 
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /transports/{transportId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (
        resource.data.userId == request.auth.uid || 
        resource.data.driverId == request.auth.uid || 
        isAdmin()
      );
    }

    match /transport/{transportId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (
        resource.data.userId == request.auth.uid || 
        isAdmin()
      );
    }

    match /cold_chain_directory/{facilityId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /oxygen_van_bookings/{bookingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // ============================================
    // 6. MARKETPLACE, COMMERCE & ORDERS
    // ============================================
    match /products/{productId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /bazaar_products/{productId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /inventory_products/{productId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /fisheries_marketplace/{itemId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (resource.data.farmerUid == request.auth.uid || resource.data.userId == request.auth.uid || isAdmin());
    }

    match /orders/{orderId} {
      allow read: if request.auth != null && (
        resource.data.buyerId == request.auth.uid || 
        resource.data.sellerId == request.auth.uid || 
        resource.data.farmerId == request.auth.uid || 
        isAdmin()
      );
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        resource.data.buyerId == request.auth.uid || 
        resource.data.sellerId == request.auth.uid || 
        resource.data.farmerId == request.auth.uid || 
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /user_carts/{cartId} {
      allow read, write: if request.auth != null && (cartId == request.auth.uid || isAdmin());
    }

    match /auctions/{auctionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || resource.data.farmerUid == request.auth.uid || isAdmin());
    }

    match /machinery/{machineryId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /machineries/{machineryId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /machinery_bookings/{bookingId} {
      allow read, write: if request.auth != null;
    }

    match /product_reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /ratings/{ratingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.raterUid == request.auth.uid;
      allow update, delete: if request.auth != null && (resource.data.raterUid == request.auth.uid || isAdmin());
    }

    match /refund_requests/{requestId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ============================================
    // 7. CHAT, ANNOUNCEMENTS & AGRI DATA
    // ============================================
    match /conversations/{conversationId} {
      allow read, write: if request.auth != null;

      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }

    match /messages/{messageId} {
      allow read, write: if request.auth != null;
    }

    match /announcements/{announcementId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /saved_agri_data/{dataId} {
      allow read, write: if request.auth != null;
    }

    match /soil_tests/{testId} {
      allow read, write: if request.auth != null;
    }

    match /services/{serviceId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /user_reports/{reportId} {
      allow read, write: if request.auth != null;
    }
  }
}
