      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Agronomy & Soil Tests
    match /saved_agri_data/{dataId} {
      allow read, write: if isAuthenticated();
    }

    match /soil_tests/{testId} {
      allow read, write: if isAuthenticated();
    }

    match /services/{serviceId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /investments/{investmentId} {
      allow read: if isAuthenticated() && (resource.data.investorId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.investorId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /investors/{investorId} {
      allow read: if isAuthenticated() && (investorId == request.auth.uid || isAdmin());
      allow write: if isAuthenticated() && (investorId == request.auth.uid || isAdmin());
    }
  }
