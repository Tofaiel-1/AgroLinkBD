rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // HELPER FUNCTIONS (AUTHENTICATION & AUTHORIZATION)
    // =========================================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAdmin() {
      return request.auth != null && (
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['super_admin', 'admin', 'moderator']) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['super_admin', 'admin', 'moderator']) ||
        (request.auth.token.email in ['superadmin@agrolink.com', 'admin@agrolinkbd.com', 'admin@agrolink.com'])
      );
    }

    function isSuperAdmin() {
      return request.auth != null && (
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super_admin') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin') ||
        (request.auth.token.email in ['superadmin@agrolink.com', 'admin@agrolinkbd.com'])
      );
    }

    function isOrderParty(data) {
      return request.auth != null && (
        data.buyerId == request.auth.uid ||
        data.sellerId == request.auth.uid ||
        data.farmerId == request.auth.uid ||
        data.farmerUid == request.auth.uid ||
        data.driverId == request.auth.uid ||
        isAdmin()
      );
    }

    // Diagnostic Connection Test
    match /_connectionTest/{testId} {
      allow read, write: if true;
    }

    // =========================================================================
    // 1. ADMIN MANAGEMENT & AUDIT LOGS
    // =========================================================================
    match /admins/{adminId} {
      allow read: if isAuthenticated() && (adminId == request.auth.uid || isSuperAdmin());
      allow create: if isAuthenticated() && (
        request.resource.data.role == 'super_admin' ||
        (isSuperAdmin() && request.resource.data.role in ['admin', 'moderator'])
      );
      allow update, delete: if isSuperAdmin();
    }

    match /admin_logs/{logId} {
      allow read, write: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }

    match /admin_approvals/{approvalId} {
      allow read, write: if isAdmin();
    }

    match /user_audit_logs/{logId} {
      allow create: if true;
      allow read, update: if isAuthenticated() && (request.auth.uid == resource.data.userId || isAdmin());
      allow delete: if isSuperAdmin();
    }

    // =========================================================================
    // 2. AI MARKET INTELLIGENCE & SUPER ADMIN PRICE CONTROL
    // =========================================================================
    // AI-generated automated price analysis, inflation insights & recommendation outputs
    match /ai_price_recommendations/{recId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // Aggregated market trends, buyer demand scores & pricing analytics
    match /market_trend_analyses/{trendId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Central government/bazaar benchmark rates (read by all farmers & buyers, updated by Admin)
    match /market_prices/{priceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Super Admin Command Center audit trail & live farmer price advisories
    match /admin_price_logs/{logId} {
      allow read: if isAuthenticated(); // Farmers stream this to calculate 1-tap price increase/decrease suggestions
      allow write: if isAdmin();
    }

    // Public price alerts, emergency caps, and market notifications
    match /global_announcements/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /announcements/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // 3. USER PROFILES, DIGITAL SOKOL CARDS & WALLETS
    // =========================================================================
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
      
      // User in-app notifications
      match /notifications/{notificationId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isAuthenticated(); // System or peer trade updates can notify
        allow update, delete: if isOwner(userId) || isAdmin();
      }

      // User penalties sub-collection
      match /penalties/{penaltyId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isAdmin();
      }

      // Farmer sub-collections
      match /ponds/{pondId} { allow read, write: if isOwner(userId) || isAdmin(); }
      match /activities/{activityId} { allow read, write: if isOwner(userId) || isAdmin(); }
      match /harvest_logs/{logId} { allow read, write: if isOwner(userId) || isAdmin(); }
      match /water_quality_logs/{logId} { allow read, write: if isOwner(userId) || isAdmin(); }
      match /feed_logs/{logId} { allow read, write: if isOwner(userId) || isAdmin(); }
      match /expenses/{expenseId} { allow read, write: if isOwner(userId) || isAdmin(); }
      match /revenues/{revenueId} { allow read, write: if isOwner(userId) || isAdmin(); }
    }

    match /buyer_profiles/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    match /driver_profiles/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // Digital Sokol Card: Publicly readable by authenticated users for QR scan / P2P trade verification
    match /cards/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    match /wallets/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isSuperAdmin();
    }

    // =========================================================================
    // 4. MARKETPLACE CATALOG & PRODUCT LISTINGS (CROPS, FISH & INPUTS)
    // =========================================================================
    // Agricultural Crops (Agri Farmer listings)
    match /products/{productId} {
      allow read: if true; // Publicly browseable in marketplace
      allow create: if isAuthenticated() && (
        request.resource.data.farmerId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        resource.data.farmerId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        isAdmin() // Super Admin Price Control updates price across target listings
      );
      allow delete: if isAuthenticated() && (
        resource.data.farmerId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );
    }

    // Local Daily Bazaar Products
    match /bazaar_products/{productId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );
    }

    // Fish Marketplace Lots (Fish Farmer harvest lots)
    match /fish_marketplace_lots/{lotId} {
      allow read: if true; // Publicly browseable
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.farmerId == request.auth.uid ||
        resource.data.farmerUid == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isAdmin() // Super Admin Price Control updates pricePerKg across lots
      );
      allow delete: if isAuthenticated() && (
        resource.data.farmerId == request.auth.uid ||
        resource.data.farmerUid == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }

    match /fisheries_marketplace/{itemId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        resource.data.farmerUid == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /crops/{cropId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /inventory_products/{productId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /service_products/{productId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.shopOwnerId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.shopOwnerId == request.auth.uid || isAdmin());
    }

    // =========================================================================
    // 5. BUYING, SHOPPING CART, WISHLIST & ORDERS LIFECYCLE
    // =========================================================================
    // Core Trade Orders (Crops, Fish Lots & Machinery)
    match /orders/{orderId} {
      allow read: if isOrderParty(resource.data);
      allow create: if isAuthenticated() && (
        request.resource.data.buyerId == request.auth.uid ||
        isAuthenticated()
      );
      allow update: if isAuthenticated() && (
        // Buyer can cancel or mark delivered/confirmed
        resource.data.buyerId == request.auth.uid ||
        // Farmer/Seller can accept, reject, mark processing/dispatched
        resource.data.sellerId == request.auth.uid ||
        resource.data.farmerId == request.auth.uid ||
        resource.data.farmerUid == request.auth.uid ||
        // Logistics Driver can update trip status and delivery location
        resource.data.driverId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin(); // Orders are protected financial records
    }

    match /service_orders/{orderId} {
      allow read: if isAuthenticated() && (
        resource.data.farmerId == request.auth.uid ||
        resource.data.shopOwnerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.farmerId == request.auth.uid ||
        resource.data.shopOwnerId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /user_carts/{cartId} {
      allow read, write: if isAuthenticated() && (cartId == request.auth.uid || isAdmin());
    }

    match /carts/{cartId} {
      allow read, write: if isAuthenticated() && (
        cartId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }

    match /wishlists/{wishlistId} {
      allow read, write: if isAuthenticated() && (
        wishlistId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }

    // =========================================================================
    // 6. SAFE ESCROW, SETTLEMENTS & FINANCIAL LEDGER
    // =========================================================================
    // Escrow holding buyer payments until harvest is safely delivered
    match /escrows/{escrowId} {
      allow read: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.farmerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid || // Buyer releases funds
        resource.data.farmerId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /escrow_records/{escrowId} {
      allow read: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.farmerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.farmerId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Farmer Payout Settlements
    match /settlements/{settlementId} {
      allow read: if isAuthenticated() && (
        resource.data.farmerId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow write: if isAdmin();
    }

    // Immutable Financial Ledger
    match /transactions/{transactionId} {
      allow get, list: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.senderUid == request.auth.uid ||
        resource.data.receiverUid == request.auth.uid ||
        resource.data.buyerId == request.auth.uid ||
        resource.data.farmerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.senderUid == request.auth.uid ||
        request.resource.data.buyerId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isAdmin(); // Protect against ledger manipulation
      allow delete: if isSuperAdmin();
    }

    match /wallet_transactions/{transactionId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /payment_requests/{requestId} {
      allow read: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.receiverId == request.auth.uid ||
        resource.data.senderId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /transfer_requests/{requestId} {
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
      allow read: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        resource.data.receiverId == request.auth.uid ||
        resource.data.senderId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /withdraw_requests/{requestId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /withdrawal_requests/{requestId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /deposit_requests/{requestId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /refund_requests/{requestId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /boost_payments/{paymentId} {
      allow read, write: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /payment_flows/{flowId} {
      allow read, write: if isAuthenticated();
    }

    match /microfinance_applications/{applicationId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /pin_reset_requests/{requestId} {
      allow read, write: if isAuthenticated();
    }

    // =========================================================================
    // 7. WHOLESALE FISH & BULK CROP AUCTIONS (LIVE BIDDING)
    // =========================================================================
    match /auctions/{auctionId} {
      allow read: if true; // Public auction viewers
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.farmerUid == request.auth.uid ||
        resource.data.farmerId == request.auth.uid ||
        // Bidder placing a new bid
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['currentBid', 'highestBid', 'highestBidderId', 'bidsCount', 'lastBidAt', 'updatedAt']) ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (resource.data.farmerId == request.auth.uid || isAdmin());

      match /bids/{bidId} {
        allow read: if true;
        allow create: if isAuthenticated() && (
          request.resource.data.bidderId == request.auth.uid ||
          request.resource.data.userId == request.auth.uid
        );
        allow update, delete: if isAdmin();
      }
    }

    match /fish_auctions/{auctionId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.farmerId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['currentBid', 'highestBid', 'highestBidderId', 'bidsCount', 'lastBidAt', 'updatedAt']) ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (resource.data.farmerId == request.auth.uid || isAdmin());

      match /bids/{bidId} {
        allow read: if true;
        allow create: if isAuthenticated() && (
          request.resource.data.bidderId == request.auth.uid ||
          request.resource.data.userId == request.auth.uid
        );
        allow update, delete: if isAdmin();
      }
    }

    match /auction_memberships/{membershipId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /vip_subscriptions/{subscriptionId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /farmer_contracts/{contractId} {
      allow read: if isAuthenticated() && (
        resource.data.farmerId == request.auth.uid ||
        resource.data.buyerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        resource.data.farmerId == request.auth.uid ||
        resource.data.buyerId == request.auth.uid ||
        isAdmin()
      );
    }

    match /fish_forward_contracts/{contractId} {
      allow read: if isAuthenticated() && (
        resource.data.farmerId == request.auth.uid ||
        resource.data.buyerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        resource.data.farmerId == request.auth.uid ||
        resource.data.buyerId == request.auth.uid ||
        isAdmin()
      );
    }

    // =========================================================================
    // 8. LOGISTICS, TRANSPORT & COLD STORAGE
    // =========================================================================
    match /transport_bookings/{bookingId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /transport_requests/{requestId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /transports/{transportId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        isAdmin()
      );
    }

    match /transport/{transportId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }

    match /cold_chain_directory/{facilityId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /oxygen_van_bookings/{bookingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        isAdmin()
      );
    }

    match /fish_trips/{tripId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        resource.data.driverId == request.auth.uid ||
        isAdmin()
      );
    }

    match /machinery/{machineryId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /machineries/{machineryId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /machinery_bookings/{bookingId} {
      allow read, write: if isAuthenticated();
    }

    // =========================================================================
    // 9. PRODUCT REVIEWS, QUALITY CONTROL & DISPUTE ARBITRATION
    // =========================================================================
    match /product_reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.raterUid == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.raterUid == request.auth.uid || isAdmin());
    }

    match /qc_inspections/{inspectionId} {
      allow read: if isAuthenticated() && (
        resource.data.farmerId == request.auth.uid ||
        resource.data.inspectorId == request.auth.uid ||
        isAdmin()
      );
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /fish_qc_inspections/{inspectionId} {
      allow read: if isAuthenticated() && (
        resource.data.farmerId == request.auth.uid ||
        resource.data.inspectorId == request.auth.uid ||
        isAdmin()
      );
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /sample_inspection_requests/{requestId} {
      allow read, write: if isAuthenticated();
    }

    match /buyer_pond_analyses/{analysisId} {
      allow read, write: if isAuthenticated();
    }

    match /user_reports/{reportId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /penalties/{penaltyId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // =========================================================================
    // 10. CHAT, NOTIFICATIONS & COMMUNITY
    // =========================================================================
    match /conversations/{conversationId} {
      allow read, write: if isAuthenticated();

      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
    }

    match /chats/{chatId} {
      allow read, write: if isAuthenticated();
    }

    match /messages/{messageId} {
      allow read, write: if isAuthenticated();
    }

    // =========================================================================
    // 11. FARM MANAGEMENT & AQUACULTURE (FARMER SUITE)
    // =========================================================================
    match /farms/{farmId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid ||
        isAdmin()
      );
    }

    match /crop_plantings/{plantingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
