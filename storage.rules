rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // ============================================
    // 1. USER PROFILES & DIGITAL SOKOL CARDS
    // ============================================
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    match /profile_pics/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.resource.size < 5 * 1024 * 1024;
    }

    match /cards/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ============================================
    // 2. BUYING & SELLING: PRODUCT & BAZAAR IMAGES
    // ============================================
    match /product_images/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.resource.size < 10 * 1024 * 1024;
    }

    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.resource.size < 10 * 1024 * 1024;
    }
    
    match /bazaar_products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.resource.size < 10 * 1024 * 1024;
    }

    // ============================================
    // 3. FISHERIES & HARVEST LOT IMAGES
    // ============================================
    match /fish_lots/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.resource.size < 10 * 1024 * 1024;
    }

    match /fish_marketplace_lots/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.resource.size < 10 * 1024 * 1024;
    }

    match /fisheries/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.resource.size < 10 * 1024 * 1024;
    }

    match /ponds/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /farms/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ============================================
    // 4. TRANSPORT, LOGISTICS & MACHINERY
    // ============================================
    match /transport/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /transports/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /machinery/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ============================================
    // 5. DOCUMENTS, INVOICES, RECEIPTS & KYC
    // ============================================
    match /invoices/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    match /receipts/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    match /microfinance_docs/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // ============================================
    // 6. AI, SOIL & DISEASE DETECTION
    // ============================================
    match /disease-detection/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    
    match /soil-analysis/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    
    // ============================================
    // 7. ADMIN ASSETS
    // ============================================
    match /admin/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
