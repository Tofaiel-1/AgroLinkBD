rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // ============================================
    // 1. USER PROFILE & SOKOL CARD IMAGES
    // ============================================
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    match /profile_pics/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId && request.resource.size < 5 * 1024 * 1024;
    }

    // ============================================
    // 2. PRODUCT & BAZAAR IMAGES
    // ============================================
    match /products/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    match /bazaar_products/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ============================================
    // 3. FARM & AQUACULTURE IMAGES
    // ============================================
    match /ponds/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /farms/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /fisheries/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ============================================
    // 4. TRANSPORT & MACHINERY
    // ============================================
    match /transport/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /transports/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /machinery/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ============================================
    // 5. DOCUMENTS, INVOICES & KYC
    // ============================================
    match /microfinance_docs/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /invoices/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ============================================
    // 6. AI, SOIL & DISEASE DETECTION
    // ============================================
    match /disease-detection/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    match /soil-analysis/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // ============================================
    // 7. ADMIN ASSETS
    // ============================================
    match /admin/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
